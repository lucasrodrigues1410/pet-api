model Breed {
  id           String     @id @default(cuid())
  animalTypeId String     @map("animal_type_id")
  name         String     @db.VarChar(255)
  
  animals      Animal[]
  animalType   AnimalType @relation(fields: [animalTypeId], references: [id])

  @@unique([animalTypeId, name])
  @@map("breeds")
}
