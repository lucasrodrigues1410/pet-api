model Appointment {
  id        String            @id @default(cuid())
  startDate DateTime          @map("start_date")
  endDate   DateTime          @map("end_date")
  status    AppointmentStatus @default(scheduled)
  price     Int
  coatType  CoatType          @map("coat_type")

  animalId  String  @map("animal_id")
  serviceId String  @map("service_id")
  staffId   String  @map("staff_id")
  clientId  String  @map("client_id")
  companyId String  @map("company_id")

  animal  Animal      @relation("AnimalAppointments", fields: [animalId], references: [id], onDelete: Cascade)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff   UserCompany @relation(fields: [staffId], references: [id], onDelete: Restrict)
  client  User        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  company Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payments Payment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([animalId])
  @@index([status])
  @@index([companyId, startDate])
  @@index([clientId, status])
  @@index([serviceId, startDate])
  @@index([startDate, endDate])
  @@index([staffId, startDate])
  @@index([deletedAt])
}

enum AppointmentStatus {
  scheduled
  confirmed
  in_progress
  completed
  no_show
  canceled
}

enum CoatType {
  short
  medium
  long
  curly
}
