model Appointment {
    id        String            @id @default(cuid())
    startDate DateTime
    endDate   DateTime
    status    AppointmentStatus @default(SCHEDULED)
    price     Decimal           @db.Decimal(10, 2)
    coatType  CoatType

    animalId  String
    serviceId String
    staffId   String

    animal  Animal      @relation("AnimalAppointments", fields: [animalId], references: [id], onDelete: Cascade)
    service Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict) // Não deletar serviço se houver agendamento
    staff   UserCompany @relation(fields: [staffId], references: [id], onDelete: Restrict) // Não deletar funcionário se houver agendamento

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
    userId    String?

    @@index([animalId])
    @@index([status])
}

enum AppointmentStatus {
    SCHEDULED
    CONFIRMED
    IN_PROGRESS
    COMPLETED
    CANCELED
}

enum CoatType {
    SHORT
    MEDIUM
    LONG
}
