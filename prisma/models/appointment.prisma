model Appointment {
    id        String            @id @default(cuid())
    startDate DateTime
    endDate   DateTime
    status    AppointmentStatus @default(SCHEDULED)
    price     Decimal           @db.Decimal(10, 2)

    clientId  String
    animalId  String
    serviceId String

    animal  Animal  @relation("AnimalAppointments", fields: [animalId], references: [id], onDelete: Cascade)
    service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict) // Não deletar serviço se houver agendamento
    client  User    @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([clientId])
    @@index([animalId])
    @@index([status])
}

enum AppointmentStatus {
    SCHEDULED
    CONFIRMED
    IN_PROGRESS
    COMPLETED
    CANCELED
}
