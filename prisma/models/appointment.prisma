model Appointment {
    id        String            @id @default(cuid())
    startDate DateTime
    endDate   DateTime
    status    AppointmentStatus @default(SCHEDULED)
    price     Decimal           @db.Decimal(10, 2)

    clientId  String
    animalId  String
    serviceId String
    paymentId String

    payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
    animal  Animal  @relation("AnimalAppointments", fields: [animalId], references: [id], onDelete: Cascade)
    service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict) // Não deletar serviço se houver agendamento
    client  User    @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([clientId])
    @@index([animalId])
    @@index([status])
}

enum AppointmentStatus {
    SCHEDULED
    CONFIRMED
    IN_PROGRESS
    COMPLETED
    CANCELED
}

model AppointmentIntent {
    id        String   @id @default(cuid())
    startDate DateTime
    endDate   DateTime
    price     Decimal  @db.Decimal(10, 2)
    validUntil DateTime

    clientId  String
    animalId  String
    serviceId String

    client  User    @relation(fields: [clientId], references: [id], onDelete: Cascade)
    animal  Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
    service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
}
