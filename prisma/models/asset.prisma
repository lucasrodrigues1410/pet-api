model Asset {
  id           String  @id @default(uuid())
  name         String  @unique
  url          String
  fileType     String? @map("file_type")
  width        Int?
  height       Int?
  thumbnailUrl String?
  fileId       String? @map("file_id")
  userId       String  @map("user_id")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companyImage CompanyImage[]
  animal       Animal[]
  company      Company[]
  user         User[]

  @@index([url])
  @@map("assets")
}
