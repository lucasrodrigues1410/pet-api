model Company {
  id            String    @id @default(cuid())
  name          String
  contact       String?
  description   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  logoAssetId   String?   @map("logo_asset_id")
  averageRating Float     @default(0) @map("average_rating")
  ratingCount   Int       @default(0) @map("rating_count")
  locationId    String    @map("location_id")

  ratings                      Rating[]
  companyUsers                 UserCompany[]
  companyAvailability          CompanyAvailability[]
  companyAvailabilityException CompanyAvailabilityException[]
  services                     Service[]
  companyImage                 CompanyImage[]
  appointment                  Appointment[]
  logo                         Asset?                         @relation(fields: [logoAssetId], references: [id])
  location                     Location                       @relation(fields: [locationId], references: [id])

  @@index([deletedAt])
  @@map("companies")
}

model UserCompany {
  id        String @id @default(cuid())
  userId    String
  companyId String
  role      Role   @default(member)

  user        User          @relation(fields: [userId], references: [id])
  company     Company       @relation(fields: [companyId], references: [id])
  appointment Appointment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, companyId])
  @@index([companyId, role])
  @@map("user_companies")
}

enum Role {
  admin
  member
}

model CompanyImage {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id])
  companyId String
  asset     Asset   @relation(fields: [assetId], references: [id])
  assetId   String

  @@map("company_images")
}
