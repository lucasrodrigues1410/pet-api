model Company {
  id            String    @id @default(cuid())
  name          String
  address       String?
  contact       String?
  description   String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  logoAssetId   String?   @map("logo_asset_id")
  averageRating Float     @default(0) @map("average_rating")
  ratingCount   Int       @default(0) @map("rating_count")

  ratings                      Rating[]
  companyUsers                 UserCompany[]
  companyAvailability          CompanyAvailability[]
  companyAvailabilityException CompanyAvailabilityException[]
  services                     Service[]
  companyLocations             CompanyLocation[]
  companyImage                 CompanyImage[]
  appointment                  Appointment[]
  logo                         Asset?                         @relation(fields: [logoAssetId], references: [id])

  @@map("companies")
}

model UserCompany {
  id        String @id @default(cuid())
  userId    String
  companyId String
  role      Role

  user        User          @relation(fields: [userId], references: [id])
  company     Company       @relation(fields: [companyId], references: [id])
  appointment Appointment[]

  @@unique([userId, companyId])
  @@map("user_companies")
}

enum Role {
  admin
  manager
  employee
}

model CompanyImage {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id])
  companyId String
  asset     Asset   @relation(fields: [assetId], references: [id])
  assetId   String

  @@map("company_images")
}
