model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  duration    Int?
  companyId   String   @map("company_id")
  isActive    Boolean  @default(true) @map("is_active")
  details     Json
  capacity    Int?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  rules       Json?
  rulesPrompt String?  @map("rules_prompt")
  requiresPayment Boolean @default(false) @map("requires_payment")

  company          Company            @relation(fields: [companyId], references: [id])
  appointments     Appointment[]
  categories       ServiceCategory[]
  promotions       ServicePromotion[]
  priceAdjustments PriceAdjustment[]

  @@index([companyId, isActive])
  @@index([isActive])
  @@map("services")
}

model ServiceCategory {
  serviceId  String   @map("service_id")
  categoryId String   @map("category_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  service    Service  @relation(fields: [serviceId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([serviceId, categoryId])
  @@map("service_categories")
}

model ServicePromotion {
  serviceId   String    @map("service_id")
  promotionId String    @map("promotion_id")
  service     Service   @relation(fields: [serviceId], references: [id])
  promotion   Promotion @relation(fields: [promotionId], references: [id])

  @@id([serviceId, promotionId])
  @@map("service_promotions")
}

model Promotion {
  id          String   @id @default(cuid())
  name        String
  description String?
  discount    Decimal  @db.Decimal(10, 2)
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  servicePromotions ServicePromotion[]

  @@index([deletedAt])
  @@index([isActive, startDate, endDate])
  @@map("promotions")
}
