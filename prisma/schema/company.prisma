model Company {
    id                           String                         @id @default(cuid())
    name                         String
    address                      String?
    contact                      String?
    createdAt                    DateTime                       @default(now())
    updatedAt                    DateTime                       @updatedAt
    logoAssetId                  String?
    companyUsers                 UserCompany[]
    companyAvailability          CompanyAvailability[]
    companyAvailabilityException CompanyAvailabilityException[]
    services                     Service[]
    companyLocations             CompanyLocation[]
    appointment Appointment[] @relation("CompanyAppointments")
    companyImage                 CompanyImage[]

    @@map("companies")
}

model UserCompany {
    id        String    @id @default(cuid())
    userId    String
    companyId String
    role      Role

    user    User    @relation(fields: [userId], references: [id])
    company Company @relation(fields: [companyId], references: [id])

    @@unique([userId, companyId])
    @@map("user_companies")
}

enum Role {
    ADMIN
    MANAGER
    EMPLOYEE
}

model CompanyImage {
    company   Company             @relation(fields: [companyId], references: [id])
    companyId String
    asset     Asset               @relation(fields: [assetId], references: [id])
    assetId   String
    purpose   CompanyImagePurpose @default(COVER)
    sortOrder Float               @default(0.0)
    version   Int                 @default(1)
    validFrom DateTime?
    validTo   DateTime?

    @@id([companyId, assetId, purpose])
    @@index([companyId, purpose, sortOrder])
    @@map("company_images")
}

enum CompanyImagePurpose {
    LOGO
    COVER
}
