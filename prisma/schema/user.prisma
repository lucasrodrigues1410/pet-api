model User {
    id        Int       @id @default(autoincrement())
    email     String    @unique
    name      String
    password  String    
    type      UserType
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")
    animal    Animal[]

    @@index([email], name: "idx_user_email")
    @@map("users")
}

enum UserType {
    CUSTOMER
    COMPANY
    ADMIN
}
