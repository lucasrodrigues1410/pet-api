model Payment {
    id                     String        @id @default(cuid())
    amount                 Decimal       @db.Decimal(10, 2)
    status                 PaymentStatus @default(PENDING)
    type                   PaymentType
    gateway                String
    gatewayTransactionId   String?       @unique
    gatewayPaymentIntentId String?       @unique
    paymentMethodDetails   Json?
    errorMessage           String?

    payer   User   @relation("Payer", fields: [payerId], references: [id], onDelete: Restrict)
    payerId String

    appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
    appointmentId String?      @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([payerId])
    @@index([status, type])
    @@index([appointmentId])
    @@index([gatewayTransactionId])
}

enum PaymentStatus {
    PENDING
    PAID
    FAILED
    REFUNDED
    CANCELED
}

enum PaymentType {
    ONE_TIME
    RECURRING
}
