model Asset {
  id           String  @id @default(uuid())
  name         String
  url          String
  fileType     String? @map("file_type")
  width        Int?
  height       Int?
  thumbnailUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companyImage CompanyImage[]
  animal Animal[]

  @@index([url])
  @@map("assets")
}
